# gptokeyb mapping for Moonrider (placeholder — refine against the game's keycodes)
# Reference: https://github.com/PortsMaster/PortMaster-gptokeyb
# The Construct 2 build reads keyboard keycodes; map the pad to those here.

back = esc
guide = esc

a = z
b = x
x = c
y = v

l1 = a
r1 = s
l2 = q
r2 = w

start = enter
select = shift

up = up
down = down
left = left
right = right

left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
